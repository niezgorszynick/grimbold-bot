# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_discord_server_id_here

# ─── Admin panel authentication ────────────────────────────────────────────────
# Generate a unique secret, for example: openssl rand -hex 32
SESSION_SECRET=
# Emergency admin login (the Root DM): username "admin"
ADMIN_PASSWORD=replace_with_a_strong_password

# ─── Panel ────────────────────────────────────────────────────────────────────
# The panel's public address: links in Discord, calendar feeds, news pages
PANEL_URL=https://panel.example.com

# ─── Discord channels (optional) ──────────────────────────────────────────────
# Threads in this channel become adventures
ADVENTURE_CHANNEL_ID=
# Each character's thread (gifts, sales)
CHARACTER_THREADS_CHANNEL_ID=
# Shop news: purchases, restocks, reservations, auctions
ANNOUNCEMENT_CHANNEL_ID=
# Auction news, if not in the announcement channel
AUCTIONS_CHANNEL_ID=
# Natural 1s and 20s on a d20 (weekly /roll and panel rolls)
NAT_ROLLS_CHANNEL_ID=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Discord IDs (comma-separated) of DMs without a panel DM account who may run /campaign
CAMPAIGN_DM_IDS=
# Avatar for Grimbrandt's webhook posts in adventure threads
GRIMBRANDT_AVATAR_URL=
# PORT=10000
# DB_PATH=data.sqlite
# UPLOADS_DIR=uploads
