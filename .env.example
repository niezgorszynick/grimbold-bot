# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_discord_server_id_here

# ─── Admin panel authentication ────────────────────────────────────────────────
# Generate a unique secret, for example: openssl rand -hex 32
SESSION_SECRET=
# Emergency admin login: username "admin"
ADMIN_PASSWORD=replace_with_a_strong_password

# Optional: if set, /show will post to this channel instead of replying in-place
SHOP_CHANNEL_ID=

# Optional: natural 1s and 20s on a d20 (weekly /roll and panel rolls) go to this channel
NAT_ROLLS_CHANNEL_ID=
